{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "distribution": "store",
      "credentialsSource": "remote",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "sandbox": {
      "extends": "production",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://sandbox-api-production-11a2a18f.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "sandbox": {
      "ios": {
        "ascAppId": "6839002635"
      }
    }
  }
}
